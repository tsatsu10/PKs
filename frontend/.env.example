VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key (public).
# Local Supabase stack: supabase/config.toml has [auth.captcha] enabled = true, so auth calls need a
# token. Use Cloudflare's always-pass test key there: 1x00000000000000000000AA
# An empty key hides the widget; that only works against a project with captcha turned off.
VITE_TURNSTILE_SITE_KEY=
